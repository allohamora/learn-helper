{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    }
  ],
  "title": "Node Exporter",
  "uid": "learn-helper-node-exporter",
  "description": "Host metrics (CPU, memory, disk, network) collected by node-exporter. See helm/README.md's Alloy section for how this data gets to Grafana Cloud. Use the Environment variable to pick production or development data.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(node_uname_info, deployment_environment_name)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Share of CPU time not spent idle, averaged across all cores. The HostHighCpuLoad alert (terraform/alerting.tf) fires above 80% sustained for 10m.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - avg without (cpu, mode) (rate(node_cpu_seconds_total{mode=\"idle\", deployment_environment_name=\"$environment\"}[5m]))) * 100",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage",
      "description": "Used memory (total minus available - available includes reclaimable cache/buffers) against total. The HostOutOfMemory alert fires when available drops below 10% of total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_memory_MemTotal_bytes{deployment_environment_name=\"$environment\"} - node_memory_MemAvailable_bytes{deployment_environment_name=\"$environment\"}",
          "legendFormat": "used ({{node}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_memory_MemTotal_bytes{deployment_environment_name=\"$environment\"}",
          "legendFormat": "total ({{node}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load average",
      "description": "1/5/15 minute load averages - number of processes runnable or waiting on uninterruptible I/O.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_load1{deployment_environment_name=\"$environment\"}",
          "legendFormat": "1m ({{node}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_load5{deployment_environment_name=\"$environment\"}",
          "legendFormat": "5m ({{node}})",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "node_load15{deployment_environment_name=\"$environment\"}",
          "legendFormat": "15m ({{node}})",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk space free",
      "description": "Free space as a share of total, per mountpoint (tmpfs/overlay excluded). The HostOutOfDiskSpace alert fires below 10%; HostDiskMayFillIn24Hours fires earlier if the trend projects a fill within 24h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\", deployment_environment_name=\"$environment\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\", deployment_environment_name=\"$environment\"}) * 100",
          "legendFormat": "{{mountpoint}} ({{node}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Bytes read/written per second, per device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(node_disk_read_bytes_total{deployment_environment_name=\"$environment\"}[5m])",
          "legendFormat": "read {{device}} ({{node}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(node_disk_written_bytes_total{deployment_environment_name=\"$environment\"}[5m])",
          "legendFormat": "write {{device}} ({{node}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Bytes received/transmitted per second, per interface (loopback excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 16, "w": 18, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(node_network_receive_bytes_total{device!=\"lo\", deployment_environment_name=\"$environment\"}[5m])",
          "legendFormat": "rx {{device}} ({{node}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\", deployment_environment_name=\"$environment\"}[5m])",
          "legendFormat": "tx {{device}} ({{node}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Uptime",
      "description": "Time since each host last booted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - node_boot_time_seconds{deployment_environment_name=\"$environment\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Swap usage",
      "description": "Percentage of configured swap in use. The HostSwapIsFillingUp alert (terraform/alerting.tf) fires above 80% sustained for 2m. No line here usually just means the host has no swap configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - (node_memory_SwapFree_bytes{deployment_environment_name=\"$environment\"} / node_memory_SwapTotal_bytes{deployment_environment_name=\"$environment\"})) * 100",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk inodes free",
      "description": "Free inodes (file/directory metadata slots) as a share of total, per mountpoint (tmpfs/overlay excluded) - distinct from the 'Disk space free' panel, since a filesystem can run out of inodes well before it runs out of bytes. The HostOutOfInodes alert fires below 10%; HostInodesMayFillIn24Hours fires earlier if the trend projects exhaustion within 24h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(node_filesystem_files_free{fstype!~\"tmpfs|overlay\", deployment_environment_name=\"$environment\"} / node_filesystem_files{fstype!~\"tmpfs|overlay\", deployment_environment_name=\"$environment\"}) * 100",
          "legendFormat": "{{mountpoint}} ({{node}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    }
  ]
}
