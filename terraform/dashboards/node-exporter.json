{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": ""
    }
  ],
  "title": "Node Exporter",
  "uid": "learn-helper-node-exporter",
  "description": "Host metrics (CPU, memory, disk, network) and pod logs collected by node-exporter. See helm/README.md's Alloy section for how this data gets to Grafana Cloud. Use the Environment variable to pick production or development data.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(node_cpu_seconds_total, deployment_environment_name)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uptime",
      "description": "Time since each host last booted. A drop to zero marks a reboot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - node_boot_time_seconds{deployment_environment_name=\"$environment\"}",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 1,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk usage %",
      "description": "Used space as a share of total, per mountpoint (tmpfs/overlay and read-only mounts excluded) - same scope as the HostOutOfDiskSpace alert (terraform/alerting.tf), not limited to specific mountpoints. Fires above 80%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\", deployment_environment_name=\"$environment\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\", deployment_environment_name=\"$environment\"})) * 100) and on(instance, device, mountpoint) (node_filesystem_readonly{deployment_environment_name=\"$environment\"} == 0)",
          "legendFormat": "{{mountpoint}} ({{node}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage %",
      "description": "Used memory (total minus available - available includes reclaimable cache/buffers) as a share of total. The HostOutOfMemory alert fires when available drops below 20% of total, i.e. used rises above 80%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - (node_memory_MemAvailable_bytes{deployment_environment_name=\"$environment\"} / node_memory_MemTotal_bytes{deployment_environment_name=\"$environment\"})) * 100",
          "legendFormat": "used ({{node}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Share of CPU time not spent idle, averaged across all cores. The HostHighCpuLoad alert (terraform/alerting.tf) fires above 80% sustained for 10m.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - avg without (cpu, mode) (rate(node_cpu_seconds_total{mode=\"idle\", deployment_environment_name=\"$environment\"}[5m]))) * 100",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Swap usage",
      "description": "Percentage of configured swap in use. The HostOutOfSwap alert (terraform/alerting.tf) fires above 80% sustained for 2m. No line here usually just means the host has no swap configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - (node_memory_SwapFree_bytes{deployment_environment_name=\"$environment\"} / node_memory_SwapTotal_bytes{deployment_environment_name=\"$environment\"})) * 100",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk load %",
      "description": "Share of time the busiest whole disk had at least one I/O operation in flight - how busy the disk is, distinct from raw throughput. Aggregated across whole disks only (partitions like vda1 excluded, since their I/O is already counted in the parent device) with max(), so multi-disk hosts are represented by their busiest disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (rate(node_disk_io_time_seconds_total{device=~\"(sd[a-z]|vd[a-z]|xvd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)\", deployment_environment_name=\"$environment\"}[5m])) * 100",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Bytes received/transmitted per second, per interface (loopback excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (node) (rate(node_network_receive_bytes_total{device!=\"lo\", deployment_environment_name=\"$environment\"}[5m]))",
          "legendFormat": "rx ({{node}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (node) (rate(node_network_transmit_bytes_total{device!=\"lo\", deployment_environment_name=\"$environment\"}[5m]))",
          "legendFormat": "tx ({{node}})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "OOM kills",
      "description": "Kernel OOM-killer process kills per 5m window, per host. node_vmstat_oom_kill is a cumulative counter since boot, so this charts increase() rather than the raw total. The HostOomKillDetected alert (terraform/alerting.tf) fires on any kill within a 15m window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "increase(node_vmstat_oom_kill{deployment_environment_name=\"$environment\"}[5m])",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "area" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Logs",
      "description": "node-exporter pod logs, latest first.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{service_name=\"node-exporter\", deployment_environment_name=\"$environment\"}",
          "maxLines": 100,
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
