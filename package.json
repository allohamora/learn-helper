{
  "name": "learn-helper",
  "type": "module",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "migrations:generate": "drizzle-kit generate",
    "migrations:up": "drizzle-kit migrate",
    "vocabulary:seed": "tsx src/server/vocabulary/vocabulary.seed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --check",
    "format:fix": "prettier --write .",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "csslint": "stylelint \"src/**/*.css\"",
    "csslint:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:client-unit": "vitest run --project client-unit",
    "test:server-unit": "vitest run --project server-unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:evals": "vitest run --project evals"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@date-fns/tz": "^1.5.0",
    "@floating-ui/react": "^0.27.20",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.9",
    "@sentry/tanstackstart-react": "^11.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^9.2.5",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "^1.168.42",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "close-with-grace": "^2.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "nitro": "^3.0.260903-beta",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-dom": "^19.3.0",
    "react-pdf": "^11.0.0",
    "react-stately": "^3.50.0",
    "react-use": "^17.6.1",
    "recharts": "3.10.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "srvx": "^1.0.5",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.40",
    "@testing-library/react": "^16.3.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-beautiful-sort": "^4.0.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "uuidv7": "^1.2.1",
    "vite": "^8.3.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "drizzle-kit": {
      "esbuild": "^0.25.0"
    },
    "react-pdf": {
      "pdfjs-dist": "$pdfjs-dist"
    },
    "@babel/plugin-transform-runtime": "^7.29.7"
  },
  "author": "https://github.com/allohamora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allohamora/learn-helper.git"
  },
  "bugs": {
    "url": "https://github.com/allohamora/learn-helper/issues"
  },
  "homepage": "https://github.com/allohamora/learn-helper#readme",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "lint-staged": {
    "*.css": "stylelint --fix",
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,cjs,mjs,json,yml,yaml,md}": "prettier --write",
    "*.tf": "terraform fmt"
  }
}
