{
  "name": "learn-helper",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "migrations:generate": "drizzle-kit generate",
    "migrations:up": "drizzle-kit migrate",
    "vocabulary:seed": "tsx src/server/vocabulary/vocabulary.seed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --check",
    "format:fix": "prettier --write .",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "csslint": "stylelint \"src/**/*.css\"",
    "csslint:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:client-unit": "vitest run --project client-unit",
    "test:server-unit": "vitest run --project server-unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:evals": "vitest run --project evals"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@date-fns/tz": "^1.5.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@tanstack/router-plugin": "^1.168.23",
    "ai": "^7.0.31",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "close-with-grace": "^2.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "lucide-react": "^1.25.0",
    "nitro": "^3.0.260610-beta",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "srvx": "^0.11.22",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/react": "^16.3.2",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-beautiful-sort": "^4.0.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "uuidv7": "^1.2.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "drizzle-kit": {
      "esbuild": "^0.25.0"
    }
  },
  "author": "https://github.com/allohamora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allohamora/learn-helper.git"
  },
  "bugs": {
    "url": "https://github.com/allohamora/learn-helper/issues"
  },
  "homepage": "https://github.com/allohamora/learn-helper#readme",
  "engines": {
    "node": ">=v24.13.0",
    "npm": ">=11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "lint-staged": {
    "*.css": "stylelint --fix",
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,cjs,mjs,json,yml,md}": "prettier --write"
  }
}
