{
  "name": "learn-helper",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "migrations:generate": "drizzle-kit generate",
    "migrations:up": "drizzle-kit migrate",
    "vocabulary:seed": "tsx src/server/vocabulary/vocabulary.seed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --check",
    "format:fix": "prettier --write .",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "csslint": "stylelint \"src/**/*.css\"",
    "csslint:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:client-unit": "vitest run --project client-unit",
    "test:server-unit": "vitest run --project server-unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:evals": "vitest run --project evals"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@date-fns/tz": "^1.5.0",
    "@floating-ui/react": "^0.27.20",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.0",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "^1.168.35",
    "ai": "^7.0.93",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "close-with-grace": "^2.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.41.0",
    "nitro": "^3.0.260903-beta",
    "pdfjs-dist": "5.4.296",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.8",
    "react-aria": "^3.52.1",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "react-stately": "^3.50.0",
    "react-use": "^17.6.1",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "srvx": "^1.0.3",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.33",
    "@testing-library/react": "^16.3.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-beautiful-sort": "^4.0.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cliff": "^2.13.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "uuidv7": "^1.2.1",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "drizzle-kit": {
      "esbuild": "^0.25.0"
    }
  },
  "author": "https://github.com/allohamora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allohamora/learn-helper.git"
  },
  "bugs": {
    "url": "https://github.com/allohamora/learn-helper/issues"
  },
  "homepage": "https://github.com/allohamora/learn-helper#readme",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "lint-staged": {
    "*.css": "stylelint --fix",
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,cjs,mjs,json,yml,yaml,md}": "prettier --write"
  }
}
