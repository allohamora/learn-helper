NODE_ENV=production # omit in development, only affects production runtime
PORT=3000 # only affects production

POSTGRES_URL=postgres://app:example@localhost:5432/test
DRIZZLE_DEBUG=false

BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_GOOGLE_CLIENT_ID=client-id
BETTER_AUTH_GOOGLE_CLIENT_SECRET=client-secret
BETTER_AUTH_ALLOWED_USERS=["example@gmail.com"]

GEMINI_API_KEY=dummy-gemini-key

# only used by evals (npm run test:evals), needs a real key to run them
OPENAI_API_KEY=dummy-openai-key

VITE_SENTRY_DSN=https://example@example.ingest.us.sentry.io/0000000000000000
SENTRY_ORG=example-org
SENTRY_PROJECT=example-project
SENTRY_AUTH_TOKEN=example-auth-token
