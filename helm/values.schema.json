{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "images", "env"],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "postgres"],
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1
        },
        "postgres": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "postgres"],
      "properties": {
        "app": {
          "$ref": "#/definitions/appEnvironment"
        },
        "postgres": {
          "$ref": "#/definitions/postgresEnvironment"
        }
      }
    }
  },
  "definitions": {
    "appEnvironment": {
      "type": "object",
      "required": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_GOOGLE_CLIENT_ID",
        "BETTER_AUTH_GOOGLE_CLIENT_SECRET",
        "BETTER_AUTH_ALLOWED_USERS",
        "GEMINI_API_KEY"
      ],
      "properties": {
        "BETTER_AUTH_SECRET": {
          "type": "string",
          "minLength": 1
        },
        "BETTER_AUTH_URL": {
          "type": "string",
          "format": "uri"
        },
        "BETTER_AUTH_GOOGLE_CLIENT_ID": {
          "type": "string",
          "minLength": 1
        },
        "BETTER_AUTH_GOOGLE_CLIENT_SECRET": {
          "type": "string",
          "minLength": 1
        },
        "BETTER_AUTH_ALLOWED_USERS": {
          "type": "string",
          "minLength": 2
        },
        "GEMINI_API_KEY": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "postgresEnvironment": {
      "type": "object",
      "required": ["POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_DB"],
      "properties": {
        "POSTGRES_USER": {
          "type": "string",
          "minLength": 1
        },
        "POSTGRES_PASSWORD": {
          "type": "string",
          "minLength": 1
        },
        "POSTGRES_DB": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
