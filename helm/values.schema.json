{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "cloudflared", "app", "postgres", "alloy", "nodeExporter"],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "cloudflared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "env"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/definitions/cloudflaredEnvironment"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/definitions/appEnvironment"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "env"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/definitions/postgresEnvironment"
        }
      }
    },
    "alloy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "env"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/definitions/alloyEnvironment"
        }
      }
    },
    "nodeExporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "appEnvironment": {
      "type": "object",
      "required": [
        "NODE_ENV",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_GOOGLE_CLIENT_ID",
        "BETTER_AUTH_GOOGLE_CLIENT_SECRET",
        "BETTER_AUTH_ALLOWED_USERS",
        "GEMINI_API_KEY",
        "OPENAI_API_KEY"
      ],
      "properties": {
        "NODE_ENV": {
          "type": "string",
          "enum": ["production", "development"]
        },
        "BETTER_AUTH_SECRET": {
          "type": "string",
          "minLength": 1
        },
        "BETTER_AUTH_URL": {
          "type": "string",
          "format": "uri"
        },
        "BETTER_AUTH_GOOGLE_CLIENT_ID": {
          "type": "string",
          "minLength": 1
        },
        "BETTER_AUTH_GOOGLE_CLIENT_SECRET": {
          "type": "string",
          "minLength": 1
        },
        "BETTER_AUTH_ALLOWED_USERS": {
          "type": "string",
          "minLength": 2
        },
        "GEMINI_API_KEY": {
          "type": "string",
          "minLength": 1
        },
        "OPENAI_API_KEY": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "postgresEnvironment": {
      "type": "object",
      "required": ["POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_DB"],
      "properties": {
        "POSTGRES_USER": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "POSTGRES_PASSWORD": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "POSTGRES_DB": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "alloyEnvironment": {
      "type": "object",
      "required": ["OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_HEADERS", "ENVIRONMENT"],
      "properties": {
        "OTEL_EXPORTER_OTLP_ENDPOINT": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "OTEL_EXPORTER_OTLP_HEADERS": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+=*$"
        },
        "ENVIRONMENT": {
          "type": "string",
          "enum": ["production", "development"]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "cloudflaredEnvironment": {
      "type": "object",
      "required": ["TUNNEL_TOKEN"],
      "properties": {
        "TUNNEL_TOKEN": {
          "type": "string",
          "minLength": 1
        },
        "TUNNEL_TRANSPORT_PROTOCOL": {
          "type": "string",
          "enum": ["auto", "http2", "quic"]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
