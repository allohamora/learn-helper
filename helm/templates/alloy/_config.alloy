{{- define "config.alloy" -}}
// ---- cloudflared tunnel metrics + logs ----
// Scoped to just the cloudflared pod via a server-side label selector, rather than
// discovering every pod in the namespace and relabeling client-side.
discovery.kubernetes "cloudflared" {
  role = "pod"

  namespaces {
    own_namespace = true // in the same namespace as alloy
  }

  selectors {
    role  = "pod"
    label = "app=cloudflared"
  }
}

// Keep only the "metrics" port target - cloudflared's deployment exposes a "metrics"
// container port (via --metrics 0.0.0.0:2000) alongside no other ports, but this
// filter is what makes that scrape-worthy port explicit rather than assumed.
discovery.relabel "cloudflared_metrics" {
  targets = discovery.kubernetes.cloudflared.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }
}

prometheus.scrape "cloudflared" {
  targets         = discovery.relabel.cloudflared_metrics.output
  job_name        = "cloudflared"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.cloudflared_keep.receiver]
}

// cloudflared exposes ~60 metric families (rpc client stats, tcp/udp session counts, icmp,
// its own Go runtime...) but only these back a dashboard panel or an alerting.tf rule - drop
// the rest rather than ship them to Grafana Cloud unused. process_start_time_seconds backs
// the Uptime panel. cloudflared_proxy_connect_latency (connection-setup time, not request/
// response time - cloudflared exposes no per-request duration metric at all) was tried and
// dropped: it only samples on a fresh connect, which barely happens once cloudflared's
// connection to the origin is warm, so it sat empty in practice.
prometheus.relabel "cloudflared_keep" {
  forward_to = [otelcol.receiver.prometheus.default.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "process_start_time_seconds|cloudflared_tunnel_ha_connections|cloudflared_tunnel_request_errors|cloudflared_tunnel_total_requests|cloudflared_tunnel_concurrent_requests_per_tunnel|cloudflared_proxy_connect_streams_errors|cloudflared_tunnel_response_by_code"
    action        = "keep"
  }
}

// Tails the cloudflared pod's stdout via the Kubernetes API - no port filter needed,
// discovery.kubernetes "cloudflared" above already scopes this to just that one pod.
loki.source.kubernetes "cloudflared" {
  targets    = discovery.kubernetes.cloudflared.targets
  forward_to = [otelcol.receiver.loki.cloudflared.receiver]
}

// ---- node-exporter host metrics + logs ----
// Scoped to just the node-exporter pods via a server-side label selector, rather than
// discovering every pod in the namespace and relabeling client-side.
discovery.kubernetes "node_exporter" {
  role = "pod"

  namespaces {
    own_namespace = true // in the same namespace as alloy
  }

  selectors {
    role  = "pod"
    label = "app=node-exporter"
  }
}

// Keep only the "metrics" port target, and copy each pod's node name onto a "node"
// label - node-exporter is a DaemonSet (one pod per node), so once this cluster grows
// beyond one node, per-host metrics need to stay distinguishable from each other.
discovery.relabel "node_exporter_metrics" {
  targets = discovery.kubernetes.node_exporter.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
    action        = "replace"
  }
}

prometheus.scrape "node_exporter" {
  targets         = discovery.relabel.node_exporter_metrics.output
  job_name        = "node-exporter"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.node_exporter_keep.receiver]
}

// Tails each node-exporter pod's stdout via the Kubernetes API - no port filter needed,
// discovery.kubernetes "node_exporter" above already scopes this to just those pods.
loki.source.kubernetes "node_exporter" {
  targets    = discovery.kubernetes.node_exporter.targets
  forward_to = [otelcol.receiver.loki.node_exporter.receiver]
}

// node-exporter's own Go runtime/process/scrape-health metrics aren't host metrics and back no
// dashboard panel or alert, so they're dropped here too - node-exporter.daemonset.yaml's
// --collector.* allow-list only controls host-metric collectors, not these. Keep only what a
// panel in dashboards/node-exporter.json or a rule in alerting.tf actually reads.
prometheus.relabel "node_exporter_keep" {
  forward_to = [otelcol.receiver.prometheus.default.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_memory_SwapTotal_bytes|node_memory_SwapFree_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_filesystem_readonly|node_filesystem_files|node_filesystem_files_free|node_disk_io_time_seconds_total|node_disk_read_bytes_total|node_disk_written_bytes_total|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_network_receive_errs_total|node_network_transmit_errs_total|node_network_receive_drop_total|node_network_transmit_drop_total|node_boot_time_seconds|node_vmstat_oom_kill"
    action        = "keep"
  }
}

{{- if .Values.kubeStateMetrics.enabled }}
// ---- kube-state-metrics cluster object-state metrics ----
// Scoped to just the kube-state-metrics pod via a server-side label selector, same as the
// two sources above.
discovery.kubernetes "kube_state_metrics" {
  role = "pod"

  namespaces {
    own_namespace = true // in the same namespace as alloy
  }

  selectors {
    role  = "pod"
    label = "app=kube-state-metrics"
  }
}

discovery.relabel "kube_state_metrics_metrics" {
  targets = discovery.kubernetes.kube_state_metrics.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }
}

prometheus.scrape "kube_state_metrics" {
  targets         = discovery.relabel.kube_state_metrics_metrics.output
  job_name        = "kube-state-metrics"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.kube_state_metrics_keep.receiver]
}

// kube-state-metrics exposes hundreds of metric families across every object kind it watches -
// keep only what backs a panel in dashboards/kubernetes.json or a rule in alerting.tf.
// kube_pod_container_resource_limits is the denominator for the CPU/memory panels' percent-of-
// limit calculation - each container's own configured limit, not a fixed/arbitrary baseline.
prometheus.relabel "kube_state_metrics_keep" {
  forward_to = [otelcol.receiver.prometheus.default.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "kube_pod_status_phase|kube_pod_container_status_restarts_total|kube_pod_container_status_last_terminated_reason|kube_deployment_status_replicas_available|kube_deployment_status_replicas_unavailable|kube_daemonset_status_number_ready|kube_node_status_condition|kube_pod_container_resource_limits"
    action        = "keep"
  }
}

// ---- kubelet/cAdvisor per-container CPU/memory metrics ----
// One target per cluster node - unlike the pod-scoped sources above, kubelet is a per-node
// component, so discovery targets nodes directly rather than a labeled pod.
discovery.kubernetes "kubelet" {
  role = "node"
}

// Every kubelet exposes /metrics/cadvisor on its own HTTPS port (10250), but that port isn't
// guaranteed reachable from Alloy's pod network depending on the node's CNI/firewall setup.
// Proxying the request through the API server (already reachable at kubernetes.default.svc:443
// from any pod) avoids that, and reuses Alloy's own in-cluster service-account token/CA below
// instead of needing kubelet's self-signed cert trusted.
discovery.relabel "kubelet_cadvisor" {
  targets = discovery.kubernetes.kubelet.targets

  rule {
    target_label = "__address__"
    replacement  = "kubernetes.default.svc:443"
  }

  rule {
    target_label = "__scheme__"
    replacement  = "https"
  }

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/$1/proxy/metrics/cadvisor"
  }

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
    action        = "replace"
  }
}

prometheus.scrape "kubelet_cadvisor" {
  targets           = discovery.relabel.kubelet_cadvisor.output
  job_name          = "kubelet-cadvisor"
  scrape_interval   = "60s"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }

  forward_to = [prometheus.relabel.kubelet_cadvisor_keep.receiver]
}

// cAdvisor emits per-cgroup series for the pod-sandbox ("POD") pause container and for cgroup
// parents (empty container label) alongside real per-container series - drop both first (a
// well-known cadvisor scrape gotcha, not a metric-name filter), then keep only the two metric
// names dashboards/kubernetes.json's container CPU/memory panels read. cAdvisor scrapes every
// container on the node regardless of namespace, so also drop anything outside this release's
// own namespace - same scoping kube-state-metrics.deployment.yaml's --namespaces flag applies,
// keeping kube-system's own pods (coredns, traefik, ...) out of the panels.
prometheus.relabel "kubelet_cadvisor_keep" {
  forward_to = [otelcol.receiver.prometheus.default.receiver]

  rule {
    source_labels = ["container"]
    regex         = "POD|"
    action        = "drop"
  }

  rule {
    source_labels = ["namespace"]
    regex         = "{{ .Release.Namespace }}"
    action        = "keep"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes"
    action        = "keep"
  }
}

// ---- kubernetes events (this release's own namespace) ----
// Scoped to this release's own namespace (not cluster-wide) so kube-system's own events
// (coredns, traefik, ...) don't clutter the Events panel - the ClusterRole/ClusterRoleBinding
// in alloy.cluster-role.yaml still grants cluster-wide "events"/"events.k8s.io" watch, broader
// than what's actually used here.
loki.source.kubernetes_events "cluster" {
  job_name   = "kubernetes-events"
  namespaces = [{{ .Release.Namespace | quote }}]
  forward_to = [otelcol.receiver.loki.k8s_events.receiver]
}
{{- end }}

{{- if .Values.postgresExporter.enabled }}
// ---- postgres metrics + logs ----
// Scoped to just the postgres pod via a server-side label selector, same as the
// other sources above.
discovery.kubernetes "postgres" {
  role = "pod"

  namespaces {
    own_namespace = true // in the same namespace as alloy
  }

  selectors {
    role  = "pod"
    label = "app=postgres"
  }
}

// Keep only the "metrics" port target - unlike cloudflared/node-exporter's
// single-container pods, the postgres pod now has two containers (postgres +
// the postgres-exporter sidecar), so this filter is what picks out the
// exporter's own port rather than assuming there's only one to find.
discovery.relabel "postgres_metrics" {
  targets = discovery.kubernetes.postgres.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metrics"
    action        = "keep"
  }
}

prometheus.scrape "postgres" {
  targets         = discovery.relabel.postgres_metrics.output
  job_name        = "postgres"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.postgres_keep.receiver]
}

// postgres_exporter's default collectors (plus stat_statements, enabled via flag
// in postgres.deployment.yaml) expose far more than this - keep only what backs
// a panel in dashboards/postgres.json or a rule in alerting.tf.
prometheus.relabel "postgres_keep" {
  forward_to = [otelcol.receiver.prometheus.default.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "pg_stat_database_numbackends|pg_settings_max_connections|pg_stat_database_blks_hit|pg_stat_database_blks_read|pg_stat_database_xact_commit|pg_stat_database_xact_rollback|pg_stat_database_deadlocks|pg_locks_count|pg_database_size_bytes|pg_stat_statements_calls_total|pg_stat_statements_seconds_total|pg_stat_statements_rows_total|pg_stat_statements_block_read_seconds_total|pg_stat_statements_block_write_seconds_total|pg_stat_user_tables_n_dead_tup|pg_stat_user_tables_n_live_tup|pg_stat_user_tables_seq_scan|pg_stat_user_tables_idx_scan"
    action        = "keep"
  }
}

// Unlike cloudflared/node-exporter's single-container pods, filter to just the
// "postgres" container's log stream so the exporter sidecar's own (uninteresting)
// stdout doesn't end up mixed into the postgres logs panels.
discovery.relabel "postgres_logs" {
  targets = discovery.kubernetes.postgres.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    regex         = "postgres"
    action        = "keep"
  }
}

loki.source.kubernetes "postgres" {
  targets    = discovery.relabel.postgres_logs.output
  forward_to = [otelcol.receiver.loki.postgres.receiver]
}
{{- end }}

otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.processor.resourcedetection.environment.input]
  }
}

otelcol.receiver.loki "cloudflared" {
  output {
    logs = [otelcol.processor.transform.cloudflared_logs.input]
  }
}

otelcol.receiver.loki "node_exporter" {
  output {
    logs = [otelcol.processor.transform.node_exporter_logs.input]
  }
}

{{- if .Values.kubeStateMetrics.enabled }}
otelcol.receiver.loki "k8s_events" {
  output {
    logs = [otelcol.processor.transform.k8s_events.input]
  }
}
{{- end }}

{{- if .Values.postgresExporter.enabled }}
otelcol.receiver.loki "postgres" {
  output {
    logs = [otelcol.processor.transform.postgres_logs.input]
  }
}
{{- end }}

// otelcol.receiver.prometheus sets service_name from the job label automatically;
// otelcol.receiver.loki has no equivalent, so logs would otherwise show up as
// unknown_service in Grafana Cloud.
otelcol.processor.transform "cloudflared_logs" {
  error_mode = "ignore"

  log_statements {
    context = "resource"
    statements = [
      `set(attributes["service.name"], "cloudflared")`,
    ]
  }

  // cloudflared is run with --output json (zerolog), so each line is a JSON object
  // with a "level" field already using OTel's own severity words (info/warn/error/...);
  // copy it onto severity_text so Grafana Cloud's detected_level reflects the real
  // level instead of falling back to unknown, and promote "message" to the log body.
  // The remaining fields vary by event type (precheck vs. tunnel connection vs. config
  // update), so each is promoted only when present rather than assumed on every line.
  log_statements {
    context = "log"
    statements = [
      `set(cache, ParseJSON(body))`,
      `set(severity_text, cache["level"]) where cache["level"] != nil`,
      `set(attributes["component"], cache["component"]) where cache["component"] != nil`,
      `set(attributes["target"], cache["target"]) where cache["target"] != nil`,
      `set(attributes["status"], cache["status"]) where cache["status"] != nil`,
      `set(attributes["conn_index"], cache["connIndex"]) where cache["connIndex"] != nil`,
      `set(attributes["connection"], cache["connection"]) where cache["connection"] != nil`,
      `set(attributes["ip"], cache["ip"]) where cache["ip"] != nil`,
      `set(attributes["location"], cache["location"]) where cache["location"] != nil`,
      `set(attributes["protocol"], cache["protocol"]) where cache["protocol"] != nil`,
      `set(attributes["run_id"], cache["run_id"]) where cache["run_id"] != nil`,
      `set(body, cache["message"]) where cache["message"] != nil`,
    ]
  }

  output {
    logs = [otelcol.processor.resourcedetection.environment.input]
  }
}

otelcol.processor.transform "node_exporter_logs" {
  error_mode = "ignore"

  log_statements {
    context = "resource"
    statements = [
      `set(attributes["service.name"], "node-exporter")`,
    ]
  }

  // node-exporter logs logfmt, not JSON (e.g. `level=INFO source=... msg="..."`), so
  // it's parsed the same way as cloudflared's JSON but with ParseKeyValue - severity_text
  // drives detected_level instead of falling back to Grafana Cloud's own heuristics.
  log_statements {
    context = "log"
    statements = [
      `set(cache, ParseKeyValue(body))`,
      `set(severity_text, cache["level"]) where cache["level"] != nil`,
      `set(body, cache["msg"]) where cache["msg"] != nil`,
    ]
  }

  output {
    logs = [otelcol.processor.resourcedetection.environment.input]
  }
}

// loki.source.kubernetes_events formats each event as logfmt by default (name=... kind=...
// reason=... type=... count=... msg="...", per grafana/alloy's event_controller.go) - promote
// the fields dashboards/kubernetes.json's Events panel reads, same as cloudflared/node-exporter's
// own log parsing above. All event types (Normal and Warning) ship through - the
// KubernetesWarningEventsElevated alert (terraform/alerting.tf) filters to "type" = "Warning"
// itself rather than relying on a Warning-only pipeline.
{{- if .Values.kubeStateMetrics.enabled }}
otelcol.processor.transform "k8s_events" {
  error_mode = "ignore"

  log_statements {
    context = "resource"
    statements = [
      `set(attributes["service.name"], "kubernetes-events")`,
    ]
  }

  log_statements {
    context = "log"
    statements = [
      `set(cache, ParseKeyValue(body))`,
      `set(severity_text, "warn") where cache["type"] == "Warning"`,
      `set(severity_text, "info") where cache["type"] == "Normal"`,
      `set(attributes["type"], cache["type"]) where cache["type"] != nil`,
      `set(attributes["reason"], cache["reason"]) where cache["reason"] != nil`,
      `set(attributes["kind"], cache["kind"]) where cache["kind"] != nil`,
      `set(attributes["name"], cache["name"]) where cache["name"] != nil`,
      `set(body, cache["msg"]) where cache["msg"] != nil`,
    ]
  }

  output {
    logs = [otelcol.processor.resourcedetection.environment.input]
  }
}
{{- end }}

// Postgres logs plain text to stderr (jsonlog isn't usable here - see
// postgres.deployment.yaml), so severity_text is pulled from the log_line_prefix's
// default "%m [%p] " format instead of a structured field - e.g.
// "2026-09-27 10:15:23.456 UTC [123] ERROR:  ...". Continuation lines
// (STATEMENT/DETAIL/HINT/CONTEXT/QUERY) repeat the same prefix but aren't
// severities of their own - they're mapped by what postgres guarantees about
// their parent line instead of guessed at. Per log_min_error_statement's docs,
// STATEMENT (the client's own failing query) is only ever printed for a message
// at error severity or worse - the default threshold, unchanged here. DETAIL/
// HINT/CONTEXT/QUERY (QUERY being the internally-generated query behind the
// error, e.g. from a trigger, as distinct from STATEMENT) aren't gated by that
// same setting and can trail a WARNING too, so with log_min_messages left at
// its 'warning' default (nothing below warning reaches the log at all), "warn"
// is the safe floor for them regardless of which of warning/error/fatal/panic
// they're actually attached to. log_error_verbosity isn't raised to VERBOSE
// here, so the SQLSTATE/LOCATION lines it would add never appear and aren't
// handled below.
{{- if .Values.postgresExporter.enabled }}
otelcol.processor.transform "postgres_logs" {
  error_mode = "ignore"

  log_statements {
    context = "resource"
    statements = [
      `set(attributes["service.name"], "postgres")`,
    ]
  }

  log_statements {
    context = "log"
    statements = [
      `set(cache, ExtractPatterns(body, "^\\S+ \\S+ \\S+ \\[\\d+\\] (?P<severity>\\w+):\\s+(?P<message>.*)$"))`,
      `set(severity_text, "debug") where IsMatch(cache["severity"], "^DEBUG")`,
      `set(severity_text, "info") where cache["severity"] == "LOG" or cache["severity"] == "INFO" or cache["severity"] == "NOTICE"`,
      `set(severity_text, "warn") where cache["severity"] == "WARNING" or cache["severity"] == "DETAIL" or cache["severity"] == "HINT" or cache["severity"] == "CONTEXT" or cache["severity"] == "QUERY"`,
      `set(severity_text, "error") where cache["severity"] == "ERROR" or cache["severity"] == "STATEMENT"`,
      `set(severity_text, "fatal") where cache["severity"] == "FATAL" or cache["severity"] == "PANIC"`,
      `set(body, cache["message"]) where cache["message"] != nil`,
    ]
  }

  output {
    logs = [otelcol.processor.resourcedetection.environment.input]
  }
}
{{- end }}

// ---- tag every metric/log with the current environment, so production and
// non-production data can be told apart in Grafana Cloud. Reads the
// OTEL_RESOURCE_ATTRIBUTES env var (set to "deployment.environment.name=<value>" in
// alloy.deployment.yaml) and stamps it onto every metric/log's resource. ----
otelcol.processor.resourcedetection "environment" {
  detectors = ["env"]

  output {
    metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
    logs    = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// ---- Grafana Cloud OTLP output ----
// OTEL_EXPORTER_OTLP_HEADERS here is just Grafana Cloud's generated
// base64(instance_id:token) value (not a full "key=value" header string), so the
// "Basic " scheme prefix is added here to form the actual Authorization header.
otelcol.auth.headers "grafana_cloud" {
  header {
    key   = "Authorization"
    value = string.format("Basic %s", sys.env("OTEL_EXPORTER_OTLP_HEADERS"))
  }
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("OTEL_EXPORTER_OTLP_ENDPOINT")
    auth     = otelcol.auth.headers.grafana_cloud.handler
  }
}
{{- end -}}
